# Hacienda Juridique - Environment Variables
# Copy this file to .env and fill in your credentials
# Priority: .env → environment variables → ~/.config/Hacienda/credentials.json

# PISTE (Legifrance API) - Required for legal source verification
PISTE_CLIENT_ID=your-client-id-here
PISTE_CLIENT_SECRET=your-client-secret-here
PISTE_ENV=production  # or "sandbox"

# Pappers (Enterprise data enrichment)
PAPPERS_API_KEY=your-pappers-api-key

# INPI (Trademarks & Patents)
INPI_DATA_LOGIN=your-inpi-login
INPI_DATA_PASSWORD=your-inpi-password

# EUIPO (EU Trademarks)
EUIPO_API_KEY=your-euipo-api-key

# OEB (European Patent Office)
OEB_CONSUMER_KEY=your-oeb-consumer-key
OEB_CONSUMER_SECRET=your-oeb-consumer-secret

# Judilibre (French case law)
JUDILIBRE_KEY_ID=your-judilibre-key-id
JUDILIBRE_ENV=production

# Cache directory (optional, defaults to ~/.cache/Hacienda or %LOCALAPPDATA%\Hacienda\cache)
# CACHE_DIR=/custom/cache/path